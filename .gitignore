# =============================================================================
# AI-Assisted GitOps Orchestration — .gitignore
# =============================================================================

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
*.pyo
*.pyd

# ── Virtual environment ───────────────────────────────────────────────────────
venv/
.venv/
env/
.env/

# ── Environment / secrets ─────────────────────────────────────────────────────
.env
.env.*
*.env
!.env.example

# ── Jupyter ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb_checkpoints

# ── Generated outputs (runtime artefacts — reproducible by running notebook) ──
outputs/audit_log*.jsonl
outputs/upgrade_report_*.md
outputs/upgrade_plan.json
outputs/proposed_changes/
outputs/notebook_runs/

# ── Python package caches ─────────────────────────────────────────────────────
.cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
coverage.xml

# ── macOS ─────────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*
.Spotlight-V100
.Trashes

# ── IDEs and editors ──────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
*.sublime-project
*.sublime-workspace

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
logs/

# ── Temporary files ───────────────────────────────────────────────────────────
*.tmp
*.bak
*.orig
tmp/
temp/

# ── Notebook build scripts (development only) ─────────────────────────────────
create_integrated_notebook.py

# ── Paper intermediate formats (keep only the PDF) ───────────────────────────
paper/*.html
paper/*.md

# ── Helm dependency cache ─────────────────────────────────────────────────────
charts/*/charts/
charts/*/Chart.lock
